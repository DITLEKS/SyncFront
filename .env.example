# Базовый URL API для прод-сборки. В dev оставьте пустым: запросы к /api
# проксируются Vite на VITE_DEV_PROXY_TARGET (см. vite.config.ts).
VITE_API_BASE_URL=

# Куда Vite проксирует /api в режиме разработки.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Откуда брать OpenAPI при генерации типов (npm run api:types).
OPENAPI_URL=http://localhost:8000/openapi.json
